{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_note": "Committed allowlist template (plan Phase 0). Activate by copying to .claude/settings.json. Kept as .example so activating your own permission grants stays an explicit human decision.",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run type-check)",
      "Bash(bun run lint)",
      "Bash(bun run build)",
      "Bash(bun run routes)",
      "Bash(bun run test:*)",
      "Bash(bun run format:*)",
      "Bash(bun run db:*)",
      "Bash(bunx wrangler d1 migrations apply:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ]
  }
}
