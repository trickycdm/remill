#!/usr/bin/env bash
# remill pre-commit hook — type-check + lint before every commit.
# Enable once per clone with:  git config core.hooksPath .githooks
#
# STATUS: the bun scripts below are wired in Phase 1 (package.json). Until then this
# hook no-ops gracefully if the scripts don't exist yet, so it's safe to enable now.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ ! -f package.json ]; then
  echo "pre-commit: no package.json yet (pre-Phase 1) — skipping type-check/lint."
  exit 0
fi

has_script() { bun run --silent "$1" --help >/dev/null 2>&1 || grep -q "\"$1\"" package.json; }

echo "pre-commit: type-check…"
if grep -q '"type-check"' package.json; then bun run type-check; fi

echo "pre-commit: lint…"
if grep -q '"lint"' package.json; then bun run lint; fi

echo "pre-commit: ok"
