{
  "name": "remill",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A lightweight, agent-native CMS on Cloudflare Workers",
  "scripts": {
    "routes": "hono-router src/routes src/router.ts",
    "routes:watch": "hono-router src/routes src/router.ts --watch",
    "dev": "bun run db:migrate && bun run routes && vite dev --host 127.0.0.1 --port 3100",
    "build": "bun run routes && vite build",
    "deploy": "bun run build && wrangler deploy",
    "type-check": "bun run routes && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --host 127.0.0.1 --port 3100",
    "e2e": "bun run db:migrate && bun run db:seed && bun run db:seed:e2e && PLAYWRIGHT_HTML_OPEN=never playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply remill --local",
    "db:migrate:remote": "wrangler d1 migrations apply remill --remote",
    "db:seed": "wrangler d1 execute remill --local --file src/db/seed.sql && bun run db:bootstrap:local",
    "db:seed:remote": "wrangler d1 execute remill --remote --file src/db/seed.sql",
    "db:bootstrap:local": "bun run scripts/bootstrap-admin.ts --local",
    "db:bootstrap:remote": "bun run scripts/bootstrap-admin.ts --remote",
    "db:seed:e2e": "bun run scripts/seed-e2e.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@noble/hashes": "^1.7.2",
    "@starfederation/datastar-sdk": "^1.0.0",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.11.3",
    "hono-router": "^1.3.1",
    "hono-sessions": "^0.5.3",
    "htmlparser2": "^12.0.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "nanoid": "^5.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@cloudflare/vite-plugin": "1.30.0",
    "@cloudflare/workers-types": "^4.20260103.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^3.2.4",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.5.1",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.58.1",
    "vite": "7.3.1",
    "vite-ssr-components": "^0.5.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.101.0"
  }
}
