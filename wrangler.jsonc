{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remill",
  "main": "src/main.tsx",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "logpush": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  // BASE_URL feeds resolveBaseUrl (share/join/email links + OpenAPI); it must
  // match where the app is actually reachable. Local dev + the e2e preview both
  // serve on 127.0.0.1:3100. EMAIL_FROM is the deploy-time default sender;
  // settings.emailFrom (admin Settings) overrides it. The Resend key is a
  // SECRET, never a var: `wrangler secret put RESEND_API_KEY` (local: .dev.vars).
  "vars": {
    "BASE_URL": "http://127.0.0.1:3100"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remill",
      // Replace with your D1 id after `wrangler d1 create remill`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "remill-media"
    }
  ],
  // KV namespace backing the fixed-window rate limiter (SEC-2). Create with
  // `wrangler kv namespace create RATE_LIMIT` and paste the returned id below.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "00000000000000000000000000000000"
    }
  ],
  // MCP server (Phase 7) binds an McpAgent Durable Object here.
  // "durable_objects": { "bindings": [{ "name": "MCP", "class_name": "RemillMcp" }] },
  "env": {
    "preview": {
      "name": "remill-preview",
      "vars": {
        "BASE_URL": "https://remill-preview.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remill-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "remill-media-preview"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT",
          "id": "00000000000000000000000000000000"
        }
      ]
    }
  }
}
